# GitHub webhook secret — must match the secret configured in GitHub webhook settings
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=

# GitHub personal access token — needs repo + pull_request scopes
GITHUB_TOKEN=

# Ollama settings — runs natively on your machine
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=codellama

# Database — defaults to SQLite (codereviews.db in backend folder)
# No need to change this unless you want to use PostgreSQL
# DATABASE_URL=sqlite+aiosqlite:///codereviews.db
